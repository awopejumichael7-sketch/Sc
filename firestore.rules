rules_version = '2';

/* ==========================================================================
   SCHOLAR'S CAMP LMS — FIRESTORE SECURITY RULES
   Deploy with: firebase deploy --only firestore:rules
   Role is resolved by checking which collection (admins/teachers/students)
   contains a document whose ID equals the caller's auth uid — this mirrors
   the exact lookup performed client-side in firebase-config.js's watchSession().
   ========================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin()    { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isTeacher()  { return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid)); }
    function isStudent()  { return isSignedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // --- People collections ---
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /teachers/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isTeacher();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwner(uid);
    }
    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isTeacher();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwner(uid);
    }

    // --- Academic structure: admin manages, everyone signed-in can read ---
    match /courses/{id}          { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subjects/{id}         { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /announcements/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/{id}         { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /roles/{id}            { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /permissions/{id}      { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- Content: admin OR the assigned teacher can write; everyone signed-in can read ---
    match /ebooks/{id}         { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /handbooks/{id}      { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /syllabus/{id}       { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /materials/{id}      { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /notes/{id}          { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /slides/{id}         { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /infographics/{id}   { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /audio/{id}          { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /videos/{id}         { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /assignments/{id}    { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /examQuestions/{id}  { allow read: if isAdmin() || isTeacher(); allow write: if isAdmin() || isTeacher(); }
    match /examinations/{id}   { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /quizzes/{id}        { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }

    // --- Student-generated content: student writes their own, teacher/admin can read all ---
    match /submissions/{id} {
      allow create: if isStudent();
      allow read, update: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
    }
    match /results/{id} {
      allow create: if isStudent();
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || isTeacher();
    }
    match /grades/{id} {
      allow create, update: if isAdmin() || isTeacher();
      allow read: if isAdmin() || isTeacher() || isStudent();
    }
    match /attendance/{id} {
      allow create, update: if isAdmin() || isTeacher();
      allow read: if isSignedIn();
    }
    match /feedback/{id} {
      allow create: if isStudent();
      allow read: if isAdmin() || isTeacher();
    }
    match /questions/{id} {
      allow create: if isStudent();
      allow read, update: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
    }
    match /bookmarks/{id} {
      allow read, write: if isStudent() && (resource == null || resource.data.studentId == request.auth.uid);
    }
    match /ai_history/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }
    match /chat/{id} {
      allow read, write: if isSignedIn();
    }

    // --- System collections: admin-only ---
    match /analytics/{id}     { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /activityLogs/{id}  { allow read: if isAdmin(); allow create: if isSignedIn(); }
    match /logs/{id}          { allow read, write: if isAdmin(); }
    match /notifications/{id} { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }

    // Default deny — anything not explicitly listed above is blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
